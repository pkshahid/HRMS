// Prisma schema for the multi-tenant Attendance, Payroll & Vacation Management System.
// Supports both self-hosted PostgreSQL and Supabase (both speak the PostgreSQL wire protocol).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase uses connection pooling (pgbouncer) in transaction mode; directUrl points to the
  // direct connection used for migrations. For local Postgres both can point to the same URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  REMOTE
  LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  ALLOWANCE
}

enum DocumentType {
  PASSPORT
  VISA
  EMIRATES_ID
  IQAMA
  NATIONAL_ID
  RESIDENCE_PERMIT
  LABOR_CARD
  CONTRACT
  OTHER
}

enum CycleStatus {
  DRAFT
  OPEN
  REVIEW_IN_PROGRESS
  CLOSED
}

enum CycleType {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  MONTHLY
  PROBATION
  PROJECT_BASED
}

enum ReviewStatus {
  NOT_STARTED
  SELF_REVIEW_PENDING
  SELF_REVIEW_DONE
  MANAGER_REVIEW_PENDING
  MANAGER_REVIEW_DONE
  CALIBRATION
  COMPLETED
  CANCELLED
}

enum ReviewerType {
  SELF
  MANAGER
  PEER
  HR
  SKIP_LEVEL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  ACHIEVED
  MISSED
  CANCELLED
}

enum GoalType {
  PERFORMANCE
  DEVELOPMENT
  BEHAVIORAL
  OKR
  KPI
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  ACCOMMODATION
  TRANSPORT
  EQUIPMENT
  TRAINING
  MEDICAL
  OFFICE_SUPPLIES
  COMMUNICATION
  MISC
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  RECOVERING
  RECOVERED
  CANCELLED
}

enum AdvanceType {
  SALARY_ADVANCE
  LOAN
  PETTY_CASH
  RELOCATION
  MEDICAL
  OTHER
}

// ---------------------------------------------------------------------------
// Tenant (organization) — root of multi-tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  country     String?
  currency    String   @default("AED")
  timezone    String   @default("Asia/Dubai")
  logoUrl     String?
  status      String   @default("active") // active | suspended | trial
  plan        String   @default("standard") // free | standard | premium
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  employees   Employee[]
  departments Department[]
  attendances Attendance[]
  leaves      LeaveRequest[]
  salaries    SalaryStructure[]
  payrolls    Payroll[]
  holidays    Holiday[]
  perfCycles  PerformanceCycle[]
  reviews     PerformanceReview[]
  goals       PerformanceGoal[]
  feedback    ReviewFeedback[]
  expenses    ExpenseClaim[]
  advances    AdvancePayment[]
  smtpConfig  SmtpConfig?
  emailLogs   EmailLog[]
  telegramConfig TelegramConfig?
  telegramLogs TelegramLog[]

  @@index([slug])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  managerId String? // references Employee.id (set via relation below)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager   Employee? @relation("DeptManager", fields: [managerId], references: [id])
  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Users (authentication) — super_admin is global (no tenant)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  tenantId      String?  // null for SUPER_ADMIN
  email         String   @unique
  passwordHash  String
  name          String
  role          UserRole @default(EMPLOYEE)
  avatarUrl     String?
  phone         String?
  isActive      Boolean  @default(true)
  // email verification & password reset
  emailVerifiedAt DateTime?
  activationToken String?
  activationTokenExpiry DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?
  // Telegram integration
  telegramChatId   String?
  telegramUsername String?
  telegramNotify   Boolean @default(true) // user opt-in for telegram notifications
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee? // back-relation; link is owned by Employee.userId

  @@index([tenantId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Employees (tenant-scoped) — includes visa / Emirates / iqama identity fields
// ---------------------------------------------------------------------------

model Employee {
  id              String          @id @default(cuid())
  tenantId        String
  userId          String?         @unique // optional linked auth user
  employeeCode    String
  firstName       String
  lastName        String
  email           String
  phone           String?
  gender          String?         // male | female | other
  dateOfBirth     DateTime?
  maritalStatus   String?
  nationality     String?
  religion        String?

  // Employment
  departmentId    String?
  designation     String?
  employmentType  EmploymentType  @default(FULL_TIME)
  status          EmployeeStatus  @default(ACTIVE)
  joinDate        DateTime
  exitDate        DateTime?
  reportingToId   String?         // references Employee.id

  // Address
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String?
  postalCode      String?

  // Identity / Immigration documents (Gulf-region focused: visa, Emirates ID, iqama)
  passportNumber  String?
  passportExpiry  DateTime?
  visaNumber      String?
  visaType        String?         // employment | visit | residence | ...
  visaExpiry      DateTime?
  emiratesIdNumber String?
  emiratesIdExpiry DateTime?
  iqamaNumber     String?
  iqamaExpiry     DateTime?
  nationalIdNumber String?
  workPermitNumber String?
  workPermitExpiry DateTime?

  // Bank
  bankName        String?
  bankAccountNumber String?
  bankIban        String?
  bankSwift       String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department?     @relation(fields: [departmentId], references: [id])
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportingTo     Employee?       @relation("ReportingTree", fields: [reportingToId], references: [id])
  subordinates    Employee[]      @relation("ReportingTree")
  managedDept     Department[]    @relation("DeptManager")
  documents       EmployeeDocument[]
  attendances     Attendance[]
  leaves          LeaveRequest[]
  salaryStructure SalaryStructure?
  payrolls        PayrollItem[]
  reviews         PerformanceReview[]
  reviewedBy      PerformanceReview[]   @relation("ReviewReviewer")
  goals           PerformanceGoal[]
  feedbackGiven   ReviewFeedback[]      @relation("FeedbackGiver")
  feedbackReceived ReviewFeedback[]     @relation("FeedbackReceiver")
  expenses        ExpenseClaim[]
  expenseApproved ExpenseClaim[]        @relation("ExpenseApprover")
  advances        AdvancePayment[]
  advanceApproved AdvancePayment[]      @relation("AdvanceApprover")

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([departmentId])
}

model EmployeeDocument {
  id          String       @id @default(cuid())
  tenantId    String
  employeeId  String
  type        DocumentType
  title       String
  fileUrl     String?
  fileNumber  String?
  issuedDate  DateTime?
  expiryDate  DateTime?
  notes       String?
  createdAt   DateTime     @default(now())

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model Attendance {
  id          String           @id @default(cuid())
  tenantId    String
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  workHours   Float?           // computed hours
  overtimeHours Float?
  lateMinutes Int?
  notes       String?
  source      String           @default("manual") // manual | biometric | mobile | api
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId])
}

model Holiday {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  date        DateTime
  type        String   @default("public") // public | company
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Vacation / Leave management
// ---------------------------------------------------------------------------

model LeaveRequest {
  id          String      @id @default(cuid())
  tenantId    String
  employeeId  String
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  totalDays   Float
  reason      String?
  attachmentUrl String?
  approverId  String?     // user who approved/rejected
  approverNote String?
  appliedAt   DateTime    @default(now())
  decidedAt   DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  year        Int
  type        LeaveType
  entitled    Float    @default(0)
  used        Float    @default(0)
  carriedForward Float @default(0)

  @@unique([tenantId, employeeId, year, type])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Salary management
// ---------------------------------------------------------------------------

model SalaryStructure {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String   @unique
  currency    String   @default("AED") // ISO 4217 code; defaults to tenant currency
  basicSalary Decimal  @db.Decimal(12, 2)
  housingAllowance Decimal @db.Decimal(12, 2) @default(0)
  transportAllowance Decimal @db.Decimal(12, 2) @default(0)
  foodAllowance Decimal @db.Decimal(12, 2) @default(0)
  otherAllowance Decimal @db.Decimal(12, 2) @default(0)
  overtimeRate Decimal @db.Decimal(12, 2) @default(0) // per hour
  // deductions
  taxRate     Decimal  @db.Decimal(5, 2) @default(0) // percentage
  insuranceRate Decimal @db.Decimal(5, 2) @default(0) // percentage
  effectiveFrom DateTime @default(now())
  effectiveTo  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components  SalaryComponent[]

  @@index([tenantId])
}

model SalaryComponent {
  id          String             @id @default(cuid())
  salaryStructureId String
  name        String
  type        SalaryComponentType
  amount      Decimal            @db.Decimal(12, 2)
  isPercentage Boolean           @default(false)
  basedOn     String?            // basic | gross

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
}

// ---------------------------------------------------------------------------
// Payroll management
// ---------------------------------------------------------------------------

model Payroll {
  id          String        @id @default(cuid())
  tenantId    String
  name        String        // e.g. "September 2026"
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime?
  status      PayrollStatus @default(DRAFT)
  currency    String        @default("AED") // ISO 4217 code; captured from tenant at generation
  totalGross  Decimal       @db.Decimal(14, 2) @default(0)
  totalDeductions Decimal    @db.Decimal(14, 2) @default(0)
  totalNet    Decimal       @db.Decimal(14, 2) @default(0)
  itemCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       PayrollItem[]

  @@index([tenantId])
  @@unique([tenantId, periodStart, periodEnd])
}

model PayrollItem {
  id          String   @id @default(cuid())
  payrollId   String
  tenantId    String
  employeeId  String
  currency    String   @default("AED") // ISO 4217 code; captured from salary structure
  basicSalary Decimal  @db.Decimal(12, 2)
  totalAllowances Decimal @db.Decimal(12, 2) @default(0)
  overtimeAmount Decimal @db.Decimal(12, 2) @default(0)
  totalDeductions Decimal @db.Decimal(12, 2) @default(0)
  taxAmount   Decimal  @db.Decimal(12, 2) @default(0)
  insuranceAmount Decimal @db.Decimal(12, 2) @default(0)
  grossPay    Decimal  @db.Decimal(12, 2)
  netPay      Decimal  @db.Decimal(12, 2)
  workingDays Int      @default(0)
  presentDays Int      @default(0)
  leaveDays   Int      @default(0)
  status      String   @default("included") // included | excluded | paid
  createdAt   DateTime @default(now())

  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Performance & Reviews
// ---------------------------------------------------------------------------

// A review cycle (e.g. "2026 Annual Review", "Q3 2026", "Probation — Fatima")
model PerformanceCycle {
  id              String      @id @default(cuid())
  tenantId        String
  name            String
  type            CycleType   @default(ANNUAL)
  status          CycleStatus @default(DRAFT)
  periodStart     DateTime
  periodEnd       DateTime
  // window when employees can submit self-assessments
  selfReviewStart DateTime?
  selfReviewEnd   DateTime?
  // window when managers can submit their reviews
  managerReviewStart DateTime?
  managerReviewEnd   DateTime?
  // rating scale config
  ratingScale     String      @default("5") // "5" = 1-5 scale, "10" = 1-10, "percent" = 0-100
  // competencies evaluated in this cycle (JSON array of {name, description})
  competencies    Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews         PerformanceReview[]
  goals           PerformanceGoal[]
  feedback        ReviewFeedback[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// A review record: one employee + one cycle + reviewer
model PerformanceReview {
  id              String       @id @default(cuid())
  tenantId        String
  cycleId         String
  employeeId      String       // person being reviewed
  reviewerId      String       // manager / reviewer
  status          ReviewStatus @default(NOT_STARTED)

  // self-assessment section
  selfRating      Int?         // overall self rating (1-5 by default)
  selfStrengths   String?
  selfImprovements String?
  selfAchievements String?
  selfComments    String?
  selfSubmittedAt DateTime?

  // manager assessment section
  managerRating   Int?
  managerStrengths String?
  managerImprovements String?
  managerAchievements String?
  managerComments String?
  managerSubmittedAt DateTime?

  // competency scores (JSON: [{name, score, comment}])
  competencyScores Json?

  // final / calibrated outcome
  finalRating     Int?
  finalComments   String?
  recommendations String?      // promotion / raise / pip / etc.
  calibrationNote String?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle           PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer        Employee     @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  feedback        ReviewFeedback[]

  @@unique([cycleId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([reviewerId])
}

// 360 / peer feedback tied to a review (optional)
model ReviewFeedback {
  id          String       @id @default(cuid())
  tenantId    String
  reviewId    String?
  cycleId     String?
  fromEmployeeId String
  toEmployeeId   String
  type        ReviewerType @default(PEER)
  rating      Int?
  strengths   String?
  improvements String?
  comments    String?
  isAnonymous Boolean      @default(false)
  submittedAt DateTime     @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review      PerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  cycle       PerformanceCycle? @relation(fields: [cycleId], references: [id])
  fromEmployee Employee    @relation("FeedbackGiver", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployee   Employee    @relation("FeedbackReceiver", fields: [toEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([toEmployeeId])
  @@index([fromEmployeeId])
}

// Goals / KPIs / OKRs for an employee (optionally linked to a cycle)
model PerformanceGoal {
  id          String     @id @default(cuid())
  tenantId    String
  employeeId  String
  cycleId     String?
  title       String
  description String?
  type        GoalType   @default(PERFORMANCE)
  status      GoalStatus @default(NOT_STARTED)
  // progress 0-100
  progress    Int        @default(0)
  // measurable target
  targetValue String?
  actualValue String?
  unit        String?
  // weight in overall score (0-100)
  weight      Int        @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle       PerformanceCycle? @relation(fields: [cycleId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([cycleId])
}

// ---------------------------------------------------------------------------
// Expenses & Advance Payments
// ---------------------------------------------------------------------------

// An expense claim submitted by an employee (header with line items)
model ExpenseClaim {
  id              String        @id @default(cuid())
  tenantId        String
  employeeId      String
  approverId      String?
  status          ExpenseStatus @default(DRAFT)
  title           String
  description     String?
  // total amount (sum of items, denormalized for quick queries)
  totalAmount     Decimal       @db.Decimal(12, 2) @default(0)
  currency        String        @default("AED")
  // expense period
  periodStart     DateTime?
  periodEnd       DateTime?
  // submission / approval tracking
  submittedAt     DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  rejectReason    String?
  // receipt attachments (JSON array of {name, url})
  receipts        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver        Employee?     @relation("ExpenseApprover", fields: [approverId], references: [id])
  items           ExpenseItem[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

// Individual expense line items within a claim
model ExpenseItem {
  id          String          @id @default(cuid())
  claimId     String
  category    ExpenseCategory @default(MISC)
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  // optional receipt for this line item
  receiptUrl  String?
  createdAt   DateTime        @default(now())

  claim       ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// Salary advance / loan / petty cash request with installment recovery
model AdvancePayment {
  id              String        @id @default(cuid())
  tenantId        String
  employeeId      String
  approverId      String?
  type            AdvanceType   @default(SALARY_ADVANCE)
  status          AdvanceStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("AED")
  reason          String?
  // disbursement
  requestDate     DateTime      @default(now())
  disburseDate    DateTime?
  // recovery plan
  installments    Int           @default(1)     // total number of installments
  installmentAmount Decimal     @db.Decimal(12, 2) @default(0)
  recoveredAmount Decimal       @db.Decimal(12, 2) @default(0)
  remainingAmount Decimal       @db.Decimal(12, 2) @default(0)
  // monthly deduction from payroll
  monthlyDeduction Decimal      @db.Decimal(12, 2) @default(0)
  // approval
  approvedAt      DateTime?
  rejectReason    String?
  // recovery tracking (JSON: [{payrollId, date, amount}])
  recoveryHistory Json?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver        Employee?     @relation("AdvanceApprover", fields: [approverId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SMTP Configuration (per-tenant, managed in Developer Settings)
// ---------------------------------------------------------------------------

model SmtpConfig {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  // connection
  host         String
  port         Int      @default(587)
  secure       Boolean  @default(false) // true for 465, false for 587/STARTTLS
  // credentials
  username     String
  password     String
  // sender
  fromName     String   @default("WorkHub")
  fromEmail    String
  replyTo      String?
  // feature toggles
  enabled      Boolean  @default(false)
  // notification preferences
  notifyLeaveApproval   Boolean @default(true)
  notifyExpenseApproval Boolean @default(true)
  notifyAdvanceApproval Boolean @default(true)
  notifyPayroll         Boolean @default(true)
  notifyPasswordReset   Boolean @default(true)
  notifyAccountActivation Boolean @default(true)
  // test / diagnostics
  lastTestAt   DateTime?
  lastTestStatus String? // success | error
  lastTestError  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Email Log — tracks all outgoing emails
// ---------------------------------------------------------------------------

enum EmailType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_PENDING
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_PAID
  ADVANCE_APPROVED
  ADVANCE_REJECTED
  ADVANCE_DISBURSED
  ADVANCE_RECOVERY
  PAYROLL_GENERATED
  PAYROLL_PAID
  PASSWORD_RESET
  ACCOUNT_ACTIVATION
  WELCOME
  TEST
  CUSTOM
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id          String      @id @default(cuid())
  tenantId    String?
  type        EmailType
  status      EmailStatus @default(PENDING)
  toEmail     String
  toName      String?
  subject     String
  body        String?
  errorMessage String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Telegram Bot Configuration (per-tenant, managed in Developer Settings)
// ---------------------------------------------------------------------------

model TelegramConfig {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  // Bot token from @BotFather
  botToken     String
  // Bot username (without @) for display / deep links
  botUsername  String?
  // Welcome message shown when users start the bot
  welcomeMessage String @default("Welcome to WorkHub Notifications! Your account is now linked.")
  // Feature toggles
  enabled      Boolean  @default(false)
  // Notification preferences (mirrors SMTP)
  notifyLeaveApproval   Boolean @default(true)
  notifyExpenseApproval Boolean @default(true)
  notifyAdvanceApproval Boolean @default(true)
  notifyPayroll         Boolean @default(true)
  notifyPasswordReset   Boolean @default(true)
  notifyAccountActivation Boolean @default(true)
  // Webhook config (optional — for receiving messages from Telegram)
  webhookUrl   String?
  webhookSecret String?
  // Test / diagnostics
  lastTestAt   DateTime?
  lastTestStatus String? // success | error
  lastTestError  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Telegram Log — tracks all outgoing Telegram messages
// ---------------------------------------------------------------------------

enum TelegramStatus {
  PENDING
  SENT
  FAILED
}

model TelegramLog {
  id          String      @id @default(cuid())
  tenantId    String?
  type        EmailType   // reuse the same email type enum
  status      TelegramStatus @default(PENDING)
  chatId      String
  toName      String?
  message     String
  errorMessage String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([type])
}
