# Example environment configuration.
# Copy to .env and adjust values.

# Local PostgreSQL container
DATABASE_URL="postgresql://attendance_admin:attendance_pass_2024@localhost:5432/attendance_db?schema=public"
DIRECT_URL="postgresql://attendance_admin:attendance_pass_2024@localhost:5432/attendance_db?schema=public"

# Supabase example (pooled + direct):
# DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# "postgres" or "supabase"
DB_PROVIDER="postgres"
